# ---- App ----
APP_ENV=dev
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---- Security / JWT ----
JWT_SECRET=change-me-in-prod-use-a-long-random-string
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
MAGIC_LINK_TTL_MIN=15
DELEGATION_TTL_HOURS=72
WEB_APP_URL=http://localhost:5173

# ---- Database (async URL for the app) ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiassessment
# Alembic uses a sync driver derived automatically (psycopg)

# ---- Freemium ----
FREE_MATURITY_LIMIT=5

# ---- Azure Blob Storage (documents). Empty => local filesystem fallback ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidence
LOCAL_STORAGE_DIR=./_storage

# ---- Azure Communication Services (email). Empty => console fallback ----
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=DoNotReply@yourbrand.example

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/estimator
